{
    "$schema": "https://unpkg.com/wrangler@4.148.0/config-schema.json",
    "name": "displate-tracker-cron",
    "main": "worker.ts",
    "compatibility_date": "2026-10-08",
    "workers_dev": false,
    "preview_urls": false,
    "triggers": {
        "crons": [
            "5 0,16 * * *",
            "2,17 8 * * *"
        ]
    },
    "observability": {
        "enabled": true
    }
}
