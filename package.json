{
	"name": "displate",
	"private": true,
	"scripts": {
		"build:web": "bun build web/app.tsx --outdir dist --minify --entry-naming '[name].[ext]' --asset-naming '[name].[ext]' && cp web/index.html web/promo_history.json dist/",
		"check": "biome check src web",
		"check:fix": "biome check --write src web",
		"daily": "bun run src/bin/daily.ts",
		"scrapper": "bun run src/bin/scrapper.ts",
		"preview": "bun run build:web && bunx --bun serve dist -nl 3000",
		"tsc": "bun ./node_modules/.bin/tsc"
	},
	"devDependencies": {
		"@biomejs/biome": "=2.5.15",
		"@types/bun": "=1.4.2",
		"pino-pretty": "=13.2.0"
	},
	"peerDependencies": {
		"typescript": "=7.0.2"
	},
	"dependencies": {
		"@fullcalendar/preact": "=7.1.1",
		"linkedom": "=0.18.13",
		"pino": "=10.4.0",
		"preact": "=11.0.1",
		"temporal-polyfill": "=1.0.5",
		"valibot": "=1.5.0"
	}
}
